{
  "manifest_version": 2,
  "id": "davidblackcn.maibot-maihush-plugin",
  "version": "0.2.2",
  "name": "MaiHush",
  "description": "Bounded social quiet and deterministic local group silence.",
  "author": {
    "name": "DavidBlackCN",
    "url": "https://github.com/DavidBlackCN"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/DavidBlackCN/maibot-maihush-plugin"
  },
  "host_application": {
    "min_version": "1.3.12",
    "max_version": "1.3.15"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.16.0"
  },
  "dependencies": [],
  "plugin_type": "extension",
  "capabilities": [
    "send.text",
    "message.get_by_id",
    "llm.generate",
    "llm.get_available_models"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ],
    "locales_path": "_locales"
  }
}
