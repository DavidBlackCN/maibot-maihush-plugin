{
  "manifest_version": 2,
  "id": "davidblackcn.maibot-maihush-plugin",
  "version": "0.3.0",
  "name": "MaiHush",
  "description": "群聊静音、自然劝静与简短确认回应。",
  "author": {
    "name": "DavidBlackCN",
    "url": "https://github.com/DavidBlackCN"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/DavidBlackCN/maibot-maihush-plugin"
  },
  "host_application": {
    "min_version": "1.3.12",
    "max_version": "1.3.18"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.19.0"
  },
  "dependencies": [],
  "plugin_type": "extension",
  "capabilities": [
    "send.text",
    "message.get_by_id",
    "llm.generate",
    "llm.get_available_models",
    "send.custom",
    "chat.get_all_streams",
    "config.get",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ],
    "locales_path": "_locales"
  }
}
